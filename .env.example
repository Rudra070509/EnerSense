# ==========================================
# EnerSense Production & Development Environment Variables
# ==========================================

# ------------------------------------------
# Frontend (Vite) Environment Variables
# (Configure these in Vercel / Netlify / Render Static)
# ------------------------------------------
# URL of your deployed Express backend (leave empty for localhost:5000 in dev)
VITE_API_URL=https://your-backend-url.onrender.com

# Google Gemini AI API Key (from https://aistudio.google.com/app/apikey)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Google OAuth 2.0 Web Client ID (from Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Optional: Custom MQTT WebSocket Broker (defaults to wss://broker.hivemq.com:8884/mqtt on HTTPS)
# VITE_MQTT_BROKER_URL=wss://broker.hivemq.com:8884/mqtt

# ------------------------------------------
# Backend (Express / Node.js) Environment Variables
# (Configure these in Render / Railway / Heroku dashboard)
# ------------------------------------------
# Port the server listens on (Render/Railway injects PORT automatically)
PORT=5000

# PostgreSQL Neon Database Connection String
DATABASE_URL=postgresql://user:password@ep-cool-fog-123456.us-east-2.aws.neon.tech/enersense?sslmode=require

# Secret key used for signing JWT authentication tokens
JWT_SECRET=generate_a_long_random_jwt_secret_here

# Gmail SMTP for OTP password reset emails (use App Password from Google Account Security)
EMAIL_USER=enersense.noreply@gmail.com
EMAIL_PASS=your_16_character_app_password
