    </mxGraphModel>
  </diagram>
  <diagram id="diagram_4" name="4. Electricity Bill Calculation Flowchart">
    <mxGraphModel dx="1422" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="1654" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t4" value="FIGURE 6.4: ELECTRICITY BILL ESTIMATION &amp; MERC TARIFF FLOWCHART" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="250" y="20" width="600" height="30" as="geometry" /></mxCell>
        <mxCell id="n4_1" value="Receive Real-Time Inputs (billing.js)&#10;• liveEnergyKwh: Total accumulated sensor kWh&#10;• currentWatts: Instantaneous active power draw (W)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontStyle=1;fontSize=10;fontColor=#0369A1;" vertex="1" parent="1"><mxGeometry x="400" y="70" width="300" height="55" as="geometry" /></mxCell>
        <mxCell id="n4_2" value="Calculate Run-Rate &amp; Projected Daily Units&#10;• runRateDailyKwh = (currentWatts × 24) / 1000&#10;• Blended Baseline: If liveEnergyKwh &gt; 0.1, use live;&#10;  Else use max(live × 2, runRateDailyKwh); Floor = 4.0 kWh" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;fontSize=9.5;" vertex="1" parent="1"><mxGeometry x="390" y="155" width="320" height="65" as="geometry" /></mxCell>
        <mxCell id="n4_3" value="Project 30-Day Monthly Consumption (Units U)&#10;projectedMonthlyKwh = estimatedDailyKwh × 30" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#475569;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="400" y="250" width="300" height="45" as="geometry" /></mxCell>
        <mxCell id="n4_4" value="MERC LT-I (B) Telescopic Slabs Energy Charge (EC)&#10;• Slab 1 (0 to 100 kWh):   Units × Rs. 3.15 / kWh&#10;• Slab 2 (101 to 300 kWh): Units × Rs. 5.40 / kWh&#10;• Slab 3 (301 to 500 kWh): Units × Rs. 7.10 / kWh&#10;• Slab 4 (&gt; 500 kWh):      Units × Rs. 8.15 / kWh&#10;energyCharges = Sum(Units_in_Slab × Slab_Rate)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=9.5;fontColor=#92400E;" vertex="1" parent="1"><mxGeometry x="380" y="325" width="340" height="90" as="geometry" /></mxCell>
        <mxCell id="n4_5" value="Evaluate Tiered Fixed Demand Charge (FC)&#10;Based on Monthly Projected Units U" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF08A;strokeColor=#CA8A04;fontStyle=1;fontSize=9.5;fontColor=#854D0E;" vertex="1" parent="1"><mxGeometry x="420" y="445" width="260" height="70" as="geometry" /></mxCell>
        <mxCell id="n4_fc_low" value="U &lt;= 100 kWh&#10;FC = Rs. 90 / mo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;fontSize=9;" vertex="1" parent="1"><mxGeometry x="230" y="460" width="120" height="40" as="geometry" /></mxCell>
        <mxCell id="n4_fc_high" value="U &gt; 500 kWh&#10;FC = Rs. 160 / mo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;fontSize=9;" vertex="1" parent="1"><mxGeometry x="740" y="460" width="120" height="40" as="geometry" /></mxCell>
        <mxCell id="n4_6" value="100 &lt; U &lt;= 500: FC = Rs. 135 / mo&#10;Wheeling Fee = U × Rs. 2.60 / kWh (Flat)&#10;Fuel Adjustment Cost (FAC) = U × Rs. 0.35 / kWh" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;fontSize=9.5;fontColor=#166534;" vertex="1" parent="1"><mxGeometry x="390" y="545" width="320" height="60" as="geometry" /></mxCell>
        <mxCell id="n4_7" value="Time-of-Day (TOD) Evaluation (MERC Surcharges / Rebates)&#10;• Night (22:00-06:00): -Rs. 0.75/u | Normal: Rs. 0.00/u&#10;• Morning (09:00-12:00): +Rs. 0.50/u | Evening (18:00-22:00): +Rs. 1.00/u" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;fontSize=9.5;fontColor=#92400E;" vertex="1" parent="1"><mxGeometry x="360" y="635" width="380" height="60" as="geometry" /></mxCell>
        <mxCell id="n4_8" value="Statutory Levies &amp; Final Monthly Bill Assessment&#10;• taxableBase = energyCharges + wheelingCharges + fixedCharges&#10;• electricityDuty = taxableBase × 0.16 (16% Maharashtra State Duty)&#10;• totalPredictedBill = taxableBase + facCharges + electricityDuty&#10;• effectiveUnitRate = totalPredictedBill / projectedMonthlyKwh" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF4FF;strokeColor=#A21CAF;fontSize=9.5;fontColor=#701A75;" vertex="1" parent="1"><mxGeometry x="360" y="725" width="380" height="80" as="geometry" /></mxCell>
        <mxCell id="n4_9" value="Dispatch Estimated Bill Object to React Context&#10;{ predictedBill, projectedMonthlyKwh, slabTier, effectiveUnitRate, tod }&#10;(Note: Estimated forecast, not an official utility bill)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#DCFCE7;strokeColor=#16A34A;fontStyle=1;fontSize=10;fontColor=#166534;" vertex="1" parent="1"><mxGeometry x="370" y="835" width="360" height="55" as="geometry" /></mxCell>
        <mxCell id="e4_1" value="" edge="1" parent="1" source="n4_1" target="n4_2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#334155;strokeWidth=1.5;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e4_2" value="" edge="1" parent="1" source="n4_2" target="n4_3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#334155;strokeWidth=1.5;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e4_3" value="" edge="1" parent="1" source="n4_3" target="n4_4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#334155;strokeWidth=1.5;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e4_4" value="" edge="1" parent="1" source="n4_4" target="n4_5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#334155;strokeWidth=1.5;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e4_5_l" value="&lt;=100" edge="1" parent="1" source="n4_5" target="n4_fc_low" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#64748B;strokeWidth=1.5;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e4_5_h" value="&gt;500" edge="1" parent="1" source="n4_5" target="n4_fc_high" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#64748B;strokeWidth=1.5;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e4_5_m" value="101-500" edge="1" parent="1" source="n4_5" target="n4_6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#16A34A;strokeWidth=1.5;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e4_6_l" value="" edge="1" parent="1" source="n4_fc_low" target="n4_6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#64748B;strokeWidth=1.5;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="290" y="575" /></Array></mxGeometry></mxCell>
        <mxCell id="e4_6_h" value="" edge="1" parent="1" source="n4_fc_high" target="n4_6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#64748B;strokeWidth=1.5;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="800" y="575" /></Array></mxGeometry></mxCell>
        <mxCell id="e4_7" value="" edge="1" parent="1" source="n4_6" target="n4_7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#334155;strokeWidth=1.5;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e4_8" value="" edge="1" parent="1" source="n4_7" target="n4_8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#334155;strokeWidth=1.5;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e4_9" value="" edge="1" parent="1" source="n4_8" target="n4_9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#334155;strokeWidth=1.5;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="diagram_5" name="5. Relay Control Flowchart">
    <mxGraphModel dx="1422" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="1654" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t5" value="FIGURE 6.5: BIDIRECTIONAL RELAY CONTROL &amp; ACTUATION FLOWCHART" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="250" y="20" width="600" height="30" as="geometry" /></mxCell>
        <mxCell id="n5_1" value="User Toggles Appliance Switch on Dashboard&#10;(Appliance 1 / Smart AC or Appliance 2 / OLED TV)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontStyle=1;fontSize=10;fontColor=#1E40AF;" vertex="1" parent="1"><mxGeometry x="400" y="70" width="300" height="50" as="geometry" /></mxCell>
        <mxCell id="n5_2" value="Frontend State Handler: toggleAppliance(id) in MqttContext.jsx&#10;• Invert requested state: newState = (!app.isOn ? 'ON' : 'OFF')&#10;• Optimistically update UI toggle state in React&#10;• Construct JSON: { 'applianceId': id, 'state': newState }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;fontSize=9.5;" vertex="1" parent="1"><mxGeometry x="380" y="150" width="340" height="65" as="geometry" /></mxCell>
        <mxCell id="n5_3" value="Publish via WebSockets to HiveMQ Broker&#10;• Client: ws://broker.hivemq.com:8000/mqtt&#10;• Topic: enersense/commands | QoS 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#EA580C;fontStyle=1;fontSize=10;fontColor=#9A3412;" vertex="1" parent="1"><mxGeometry x="410" y="245" width="280" height="50" as="geometry" /></mxCell>
        <mxCell id="n5_4" value="ESP32 Receives Command via MQTT Callback&#10;• Subscribed Topic: enersense/commands&#10;• Inbound payload copied to local memory buffer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=9.5;fontColor=#92400E;" vertex="1" parent="1"><mxGeometry x="410" y="325" width="280" height="50" as="geometry" /></mxCell>
        <mxCell id="n5_5" value="Parse JSON Payload with ArduinoJson&#10;Deserialization Successful?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF08A;strokeColor=#CA8A04;fontStyle=1;fontSize=9.5;fontColor=#854D0E;" vertex="1" parent="1"><mxGeometry x="430" y="405" width="240" height="65" as="geometry" /></mxCell>
        <mxCell id="n5_5_err" value="Payload Error! Discard packet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;fontSize=9;fontColor=#991B1B;" vertex="1" parent="1"><mxGeometry x="730" y="417" width="160" height="40" as="geometry" /></mxCell>
        <mxCell id="n5_6" value="Identify Target Appliance&#10;(applianceId == 1 ?)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF08A;strokeColor=#CA8A04;fontStyle=1;fontSize=9.5;fontColor=#854D0E;" vertex="1" parent="1"><mxGeometry x="450" y="500" width="200" height="65" as="geometry" /></mxCell>
        <mxCell id="n5_ch1" value="Target: Appliance 1 (Smart AC)&#10;• Pin: GPIO 26&#10;• ON -&gt; digitalWrite(26, LOW)&#10;• OFF -&gt; digitalWrite(26, HIGH)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontSize=9.5;fontColor=#0369A1;" vertex="1" parent="1"><mxGeometry x="250" y="595" width="240" height="65" as="geometry" /></mxCell>
        <mxCell id="n5_ch2" value="Target: Appliance 2 (OLED TV)&#10;• Pin: GPIO 27&#10;• ON -&gt; digitalWrite(27, LOW)&#10;• OFF -&gt; digitalWrite(27, HIGH)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF4FF;strokeColor=#A21CAF;fontSize=9.5;fontColor=#701A75;" vertex="1" parent="1"><mxGeometry x="610" y="595" width="240" height="65" as="geometry" /></mxCell>
        <mxCell id="n5_7" value="Optocoupler PC817 &amp; Relay Coil Stage&#10;• LOW signal grounds optocoupler cathode -&gt; IR LED illuminates&#10;• Internal phototransistor switches NPN driver transistor&#10;• Songle 5V coil energizes; 1N4007 flyback diode clamps spikes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=9.5;fontColor=#92400E;" vertex="1" parent="1"><mxGeometry x="360" y="695" width="380" height="70" as="geometry" /></mxCell>
        <mxCell id="n5_8" value="Mechanical Switching &amp; AC 230V Circuit Completion&#10;• NO (Normally Open) contact snaps to COM (Common)&#10;• High-voltage 230V live path to Bulb 1 / Bulb 2 connects" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;fontStyle=1;fontSize=9.5;fontColor=#991B1B;" vertex="1" parent="1"><mxGeometry x="370" y="795" width="360" height="55" as="geometry" /></mxCell>
        <mxCell id="n5_9" value="Closed-Loop Physical Verification via PZEM CT Coils&#10;• CT Coil detects instantaneous current drop or rise (e.g. 0W &lt;-&gt; 60W)&#10;• Next 5s telemetry cycle confirms physical load state on dashboard" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#DCFCE7;strokeColor=#16A34A;fontStyle=1;fontSize=9.5;fontColor=#166534;" vertex="1" parent="1"><mxGeometry x="360" y="880" width="380" height="55" as="geometry" /></mxCell>
        <mxCell id="e5_1" value="" edge="1" parent="1" source="n5_1" target="n5_2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#334155;strokeWidth=1.5;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e5_2" value="" edge="1" parent="1" source="n5_2" target="n5_3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#334155;strokeWidth=1.5;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e5_3" value="" edge="1" parent="1" source="n5_3" target="n5_4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#334155;strokeWidth=1.5;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e5_4" value="" edge="1" parent="1" source="n5_4" target="n5_5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#334155;strokeWidth=1.5;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e5_5_no" value="No" edge="1" parent="1" source="n5_5" target="n5_5_err" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#EF4444;strokeWidth=1.5;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e5_5_yes" value="Yes" edge="1" parent="1" source="n5_5" target="n5_6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#16A34A;strokeWidth=1.5;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e5_6_1" value="applianceId == 1" edge="1" parent="1" source="n5_6" target="n5_ch1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#0284C7;strokeWidth=1.5;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e5_6_2" value="applianceId == 2" edge="1" parent="1" source="n5_6" target="n5_ch2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#A21CAF;strokeWidth=1.5;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e5_7_1" value="" edge="1" parent="1" source="n5_ch1" target="n5_7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#334155;strokeWidth=1.5;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e5_7_2" value="" edge="1" parent="1" source="n5_ch2" target="n5_7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#334155;strokeWidth=1.5;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e5_8" value="" edge="1" parent="1" source="n5_7" target="n5_8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#334155;strokeWidth=1.5;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e5_9" value="" edge="1" parent="1" source="n5_8" target="n5_9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#334155;strokeWidth=1.5;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
