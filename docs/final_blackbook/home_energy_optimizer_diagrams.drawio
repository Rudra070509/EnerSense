  <diagram id="diagram_6" name="6. AI Recommendation Flowchart">
    <mxGraphModel dx="1422" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="1654" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t6" value="FIGURE 6.6: GOOGLE GEMINI AI ADVISORY PIPELINE FLOWCHART" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="250" y="20" width="600" height="30" as="geometry" /></mxCell>
        <mxCell id="n6_1" value="User Submits Energy Question in AI Assistant&#10;(DashboardPage.jsx GlassCard Chat Widget)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAEAFF;strokeColor=#C026D3;fontStyle=1;fontSize=10;fontColor=#86198F;" vertex="1" parent="1"><mxGeometry x="400" y="70" width="300" height="45" as="geometry" /></mxCell>
        <mxCell id="n6_2" value="Trigger handleSendChat() Event Handler&#10;• Validate query text &amp;&amp; !isAiLoading&#10;• Optimistically append user message to chat UI&#10;• Activate Loader2 typing spinner indicator" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;fontSize=9.5;" vertex="1" parent="1"><mxGeometry x="400" y="145" width="300" height="60" as="geometry" /></mxCell>
        <mxCell id="n6_3" value="Context Aggregator: Extract Real-Time Telemetry&#10;• totalPowerToday: liveEnergy + ' kWh'&#10;• currentWatts: livePower + ' W'&#10;• liveVoltage: (liveVoltage || 238) + ' V'&#10;• estMonthlyBill: 'Rs. ' + predictedBill&#10;• topAppliances: 'Smart AC (' + p1 + '%), TV (' + p2 + '%)'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontSize=9.5;fontColor=#0369A1;" vertex="1" parent="1"><mxGeometry x="380" y="235" width="340" height="85" as="geometry" /></mxCell>
        <mxCell id="n6_4" value="Structured Prompt Synthesis (src/utils/gemini.js)&#10;• Persona: 'EnerSense AI, concise smart home expert'&#10;• Injected Context: Live metrics + MERC TOD tariff rules&#10;• Behavioral Rule: Maximum 2 sentences; concrete advice&#10;• Model Config: Temperature 0.5 (factual precision)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=9.5;fontColor=#92400E;" vertex="1" parent="1"><mxGeometry x="380" y="345" width="340" height="80" as="geometry" /></mxCell>
        <mxCell id="n6_5" value="Dispatch HTTPS Request via @google/genai SDK&#10;• Model: gemini-3.5-flash / gemini-1.5-flash&#10;• Key: VITE_GEMINI_API_KEY environment variable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#EA580C;fontStyle=1;fontSize=10;fontColor=#9A3412;" vertex="1" parent="1"><mxGeometry x="390" y="455" width="320" height="50" as="geometry" /></mxCell>
        <mxCell id="n6_6" value="HTTPS Response Received&#10;within Timeout (Status 200)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF08A;strokeColor=#CA8A04;fontStyle=1;fontSize=9.5;fontColor=#854D0E;" vertex="1" parent="1"><mxGeometry x="430" y="535" width="240" height="65" as="geometry" /></mxCell>
        <mxCell id="n6_6_err" value="API Catch Handler&#10;Return Fallback Message:&#10;'Gemini API key is missing or invalid'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;fontSize=9;fontColor=#991B1B;" vertex="1" parent="1"><mxGeometry x="720" y="542" width="180" height="50" as="geometry" /></mxCell>
        <mxCell id="n6_7" value="Extract &amp; Sanitize AI Response Text&#10;• Parse response.text&#10;• Trim excess whitespace &amp; enforce compact UI format" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;fontSize=9.5;fontColor=#166534;" vertex="1" parent="1"><mxGeometry x="400" y="630" width="300" height="50" as="geometry" /></mxCell>
        <mxCell id="n6_8" value="Update Reactive Chat State &amp; View&#10;• Append { role: 'ai', text: aiResponse } to messages&#10;• Hide Loader2 typing spinner (setIsAiLoading(false))&#10;• Auto-scroll window: chatEndRef.current.scrollIntoView()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;fontSize=9.5;fontColor=#1D4ED8;" vertex="1" parent="1"><mxGeometry x="380" y="710" width="340" height="65" as="geometry" /></mxCell>
        <mxCell id="n6_9" value="Render Formatted GlassCard Bubble&#10;Actionable Energy Optimization Guidance Delivered" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#DCFCE7;strokeColor=#16A34A;fontStyle=1;fontSize=10;fontColor=#166534;" vertex="1" parent="1"><mxGeometry x="390" y="805" width="320" height="45" as="geometry" /></mxCell>
