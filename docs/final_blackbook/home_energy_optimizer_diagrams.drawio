        <mxCell id="n1_10" value="Serialize JSON Telemetry Payload&#10;{ voltage, totalPower, totalEnergy,&#10;appliances: [ {id:1, power...}, {id:2...} ] }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;fontSize=10;" vertex="1" parent="1"><mxGeometry x="430" y="810" width="240" height="55" as="geometry" /></mxCell>
