        <mxCell id="g3_broker" value="MQTT CLOUD BROKER TIER (HiveMQ Public)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;fontStyle=1;fontSize=11;fontColor=#92400E;" vertex="1" parent="1"><mxGeometry x="380" y="80" width="280" height="360" as="geometry" /></mxCell>
        <mxCell id="n3_tcp" value="MQTT TCP Endpoint&#10;broker.hivemq.com:1883" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=10;fontStyle=1;" vertex="1" parent="g3_broker"><mxGeometry x="30" y="45" width="220" height="40" as="geometry" /></mxCell>
        <mxCell id="n3_top_telem" value="Topic: enersense/telemetry&#10;JSON Payload Every 5000ms" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=9.5;fontColor=#166534;" vertex="1" parent="g3_broker"><mxGeometry x="30" y="115" width="220" height="45" as="geometry" /></mxCell>
        <mxCell id="n3_top_cmd" value="Topic: enersense/commands&#10;Actuation Commands {applianceId, state}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#EA580C;fontSize=9.5;fontColor=#9A3412;" vertex="1" parent="g3_broker"><mxGeometry x="30" y="190" width="220" height="45" as="geometry" /></mxCell>
        <mxCell id="n3_ws" value="WebSockets Port 8000 Bridge&#10;ws://broker.hivemq.com:8000/mqtt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontSize=10;fontStyle=1;" vertex="1" parent="g3_broker"><mxGeometry x="30" y="265" width="220" height="40" as="geometry" /></mxCell>
        <mxCell id="g3_front" value="WEB APPLICATION TIER (React 18 &amp; Vite)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;fontStyle=1;fontSize=11;fontColor=#166534;" vertex="1" parent="1"><mxGeometry x="750" y="80" width="280" height="360" as="geometry" /></mxCell>
        <mxCell id="n3_mqtt_ctx" value="MqttContext.jsx Hook&#10;Direct WebSocket Client (mqtt.js)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontStyle=1;fontSize=10;" vertex="1" parent="g3_front"><mxGeometry x="30" y="45" width="220" height="45" as="geometry" /></mxCell>
        <mxCell id="n3_billing" value="billing.js Engine&#10;MERC LT-I (B) Slab Calculation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF4FF;strokeColor=#A21CAF;fontSize=9.5;fontColor=#701A75;" vertex="1" parent="g3_front"><mxGeometry x="30" y="115" width="220" height="45" as="geometry" /></mxCell>
        <mxCell id="n3_ui" value="Dashboard &amp; Graph Components&#10;Recharts Live Power Trend &amp; Gauges" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;fontSize=9.5;" vertex="1" parent="g3_front"><mxGeometry x="30" y="190" width="220" height="45" as="geometry" /></mxCell>
        <mxCell id="n3_ai_chat" value="AI Advisor Chat Widget&#10;Live Prompt Context Injection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAEAFF;strokeColor=#C026D3;fontSize=9.5;fontColor=#86198F;" vertex="1" parent="g3_front"><mxGeometry x="30" y="265" width="220" height="40" as="geometry" /></mxCell>
        <mxCell id="n3_backend" value="Node.js &amp; Express Backend (Port 5000)&#10;User Auth, JWT &amp; Neon PostgreSQL DB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="400" y="490" width="280" height="50" as="geometry" /></mxCell>
        <mxCell id="n3_gemini" value="Google Gemini API (gemini-3.5-flash)&#10;HTTPS REST Endpoint via @google/genai" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF4FF;strokeColor=#A21CAF;fontSize=10;fontStyle=1;fontColor=#701A75;" vertex="1" parent="1"><mxGeometry x="750" y="490" width="280" height="50" as="geometry" /></mxCell>
        <mxCell id="e3_1" value="Publish Telemetry (1883)" edge="1" parent="1" source="n3_wifi" target="n3_tcp" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#16A34A;strokeWidth=1.5;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e3_2" value="Receive Commands (1883)" edge="1" parent="1" source="n3_tcp" target="n3_esp" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#EA580C;strokeWidth=1.5;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="340" y="145" /><mxPoint x="340" y="215" /></Array></mxGeometry></mxCell>
        <mxCell id="e3_3" value="Forward to WS (8000)" edge="1" parent="1" source="n3_top_telem" target="n3_ws" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#16A34A;strokeWidth=1.5;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e3_4" value="WebSocket Stream" edge="1" parent="1" source="n3_ws" target="n3_mqtt_ctx" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#16A34A;strokeWidth=1.5;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="710" y="365" /><mxPoint x="710" y="145" /></Array></mxGeometry></mxCell>
        <mxCell id="e3_5" value="Publish Commands (WS)" edge="1" parent="1" source="n3_mqtt_ctx" target="n3_top_cmd" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#EA580C;strokeWidth=1.5;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="730" y="155" /><mxPoint x="730" y="295" /></Array></mxGeometry></mxCell>
        <mxCell id="e3_6" value="HTTP Auth / Profiling" edge="1" parent="1" source="n3_ui" target="n3_backend" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#64748B;strokeWidth=1.5;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e3_7" value="HTTPS Prompt / Advice" edge="1" parent="1" source="n3_ai_chat" target="n3_gemini" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#C026D3;strokeWidth=1.5;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
