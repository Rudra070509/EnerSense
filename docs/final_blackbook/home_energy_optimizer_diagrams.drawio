        <mxCell id="t2" value="FIGURE 6.2: DUAL PZEM-004T SENSOR ACQUISITION FLOWCHART" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="250" y="20" width="600" height="30" as="geometry" /></mxCell>
        <mxCell id="n2_1" value="Start Sensor Polling Loop&#10;(Scheduled every 5000ms)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#E2E8F0;strokeColor=#475569;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="450" y="70" width="200" height="40" as="geometry" /></mxCell>
        <mxCell id="n2_2" value="Configure Hardware Serial2&#10;• Pins: GPIO 16 (RX2), GPIO 17 (TX2)&#10;• Baud Rate: 9600 bps, 8N1 Modbus RTU" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;fontSize=10;" vertex="1" parent="1"><mxGeometry x="430" y="140" width="240" height="55" as="geometry" /></mxCell>
        <mxCell id="n2_3" value="Transmit Modbus Command to Sensor 1&#10;• Slave Address: 0xF8 (Broadcast / Current Addr)&#10;• Function Code: 0x04 (Read Input Registers)&#10;• Register Range: 0x0000 - 0x0009 (10 Regs)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontSize=9.5;fontColor=#0369A1;" vertex="1" parent="1"><mxGeometry x="420" y="225" width="260" height="65" as="geometry" /></mxCell>
        <mxCell id="n2_4" value="Response Received&#10;within 200ms Timeout?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF08A;strokeColor=#CA8A04;fontStyle=1;fontSize=10;fontColor=#854D0E;" vertex="1" parent="1"><mxGeometry x="480" y="320" width="140" height="65" as="geometry" /></mxCell>
        <mxCell id="n2_4_timeout" value="Timeout Error!&#10;Check AC live plug, 5V rail,&#10;and Optocoupler seating" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;fontSize=9;fontColor=#991B1B;" vertex="1" parent="1"><mxGeometry x="700" y="330" width="160" height="45" as="geometry" /></mxCell>
        <mxCell id="n2_5" value="Modbus 16-Bit CRC Checksum Valid?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF08A;strokeColor=#CA8A04;fontStyle=1;fontSize=10;fontColor=#854D0E;" vertex="1" parent="1"><mxGeometry x="470" y="415" width="160" height="65" as="geometry" /></mxCell>
        <mxCell id="n2_5_crc" value="CRC Checksum Mismatch!&#10;Frame corrupted by EMI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;fontSize=9;fontColor=#991B1B;" vertex="1" parent="1"><mxGeometry x="700" y="425" width="160" height="45" as="geometry" /></mxCell>
        <mxCell id="n2_6" value="Extract 6 Core Electrical Parameters:&#10;• Voltage (V): Scale 0.1V&#10;• Current (A): Scale 0.001A&#10;• Power (W): Scale 0.1W&#10;• Energy (kWh): Scale 1 Wh&#10;• Frequency (Hz): Scale 0.1Hz&#10;• Power Factor: Scale 0.01" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;fontSize=9.5;fontColor=#166534;" vertex="1" parent="1"><mxGeometry x="430" y="510" width="240" height="100" as="geometry" /></mxCell>
        <mxCell id="n2_7" value="Check Value Sanity:&#10;!isnan(v, i, p, e) &amp;&amp; v &gt; 50V?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF08A;strokeColor=#CA8A04;fontStyle=1;fontSize=10;fontColor=#854D0E;" vertex="1" parent="1"><mxGeometry x="470" y="640" width="160" height="65" as="geometry" /></mxCell>
        <mxCell id="n2_8" value="Channel 2 Acquisition Architecture:&#10;• Dual-UART Target: Serial1 (GPIO 18 RX, 19 TX)&#10;• Test Bench Implementation: Mirror Working Sensor&#10;  to avoid bench halt from damaged optocoupler" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;fontSize=9.5;fontColor=#92400E;" vertex="1" parent="1"><mxGeometry x="420" y="735" width="260" height="65" as="geometry" /></mxCell>
        <mxCell id="n2_9" value="Aggregate Telemetry Channels&#10;• Appliance 1: V1, I1, P1, E1, PF1 (Smart AC)&#10;• Appliance 2: V2, I2, P2, E2, PF2 (OLED TV)&#10;• Aggregates: Total Watts = P1+P2, Total kWh = E1+E2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;fontSize=9.5;fontColor=#1E40AF;" vertex="1" parent="1"><mxGeometry x="420" y="830" width="260" height="65" as="geometry" /></mxCell>
        <mxCell id="n2_10" value="Pass Structured Telemetry to&#10;MQTT Publishing Pipeline" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#DCFCE7;strokeColor=#16A34A;fontStyle=1;fontSize=10;fontColor=#166534;" vertex="1" parent="1"><mxGeometry x="450" y="925" width="200" height="45" as="geometry" /></mxCell>
        <mxCell id="e2_1" value="" edge="1" parent="1" source="n2_1" target="n2_2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#334155;strokeWidth=1.5;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
